# PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost/mydb

# AI backends
ANTHROPIC_API_KEY=

# Google Places API (New) — business resolution for sign-scan research and the
# city research pipeline. Without it, google_maps_search logs a warning and
# returns [], so those flows degrade to web-search-only rather than failing.
GOOGLE_MAPS_API_KEY=

# Bright Data Web Unlocker — used by fetch_page() for bot-resistant sites.
# Without it, fetch_page falls back to a plain httpx GET.
BRIGHTDATA_API_TOKEN=

# --- Security (REQUIRED in production) ---
# Set APP_ENV=production in the deployed .env. With it set, the app refuses to
# start unless JWT_SECRET and SESSION_SECRET are set to strong, non-default values.
# Generate each with:  openssl rand -hex 32
APP_ENV=development
JWT_SECRET=
SESSION_SECRET=
# Set true when served over HTTPS so the session cookie carries the Secure flag.
SESSION_COOKIE_SECURE=false
# Transitional shared break-glass admin password. Unset once real accounts exist.
ADMIN_PASSWORD=

# Mail (SMTP + IMAP — any standard mail server)
MAIL_SMTP_HOST=mail.example.com
MAIL_SMTP_PORT=587
MAIL_IMAP_HOST=mail.example.com
MAIL_IMAP_PORT=143
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=mailbox_password
MAIL_FROM_EMAIL=you@example.com

# Server
HOST=127.0.0.1
PORT=8000

# Public URL the app is served at — used to build links in outgoing emails
# (e.g. the password-reset link). Must be the real https:// domain in
# production, or emailed links will point at 127.0.0.1.
APP_PUBLIC_URL=http://127.0.0.1:8000

# Scout threshold — contacts below this score are dropped. Lower when you want more volume.
SCOUT_THRESHOLD=75

# Business-card capture — where photographed card images are stored.
# In Docker this is a mounted volume (see docker-compose.yml). Images are personal
# data: with retention 0 the image is deleted on confirm (extracted text is kept).
CARD_IMAGE_DIR=/data/card-images
CARD_IMAGE_RETENTION_DAYS=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_CHEAP_LLM=deepseek-v4-flash
DEFAULT_SMART_LLM=claude
# Review these with the controller/counsel before production use.
CONTACT_RETENTION_DAYS=1095
INBOX_RETENTION_DAYS=365
AGENT_RUN_RETENTION_DAYS=1095
AUDIT_LOG_RETENTION_DAYS=730
PUSH_TOKEN_RETENTION_DAYS=90
