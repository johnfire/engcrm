# PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost/mydb

# AI backends
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=

# --- Security (REQUIRED in production) ---
# Set APP_ENV=production in the deployed .env. With it set, the app refuses to
# start unless JWT_SECRET and SESSION_SECRET are set to strong, non-default values.
# Generate each with:  openssl rand -hex 32
APP_ENV=development
JWT_SECRET=
SESSION_SECRET=
# Set true when served over HTTPS so the session cookie carries the Secure flag.
SESSION_COOKIE_SECURE=false
# Transitional shared break-glass admin password. Unset once real accounts exist.
ADMIN_PASSWORD=

# Proton Bridge (IMAP + SMTP — must be running locally)
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SMTP_HOST=127.0.0.1
PROTON_SMTP_PORT=1025
PROTON_EMAIL=your@proton.me
PROTON_PASSWORD=bridge_app_password

# Server
HOST=127.0.0.1
PORT=8000

# Scout threshold — contacts below this score are dropped. Lower when you want more volume.
SCOUT_THRESHOLD=75

# Business-card capture — where photographed card images are stored.
# In Docker this is a mounted volume (see docker-compose.yml). Images are personal
# data: with retention 0 the image is deleted on confirm (extracted text is kept).
CARD_IMAGE_DIR=/data/card-images
CARD_IMAGE_RETENTION_DAYS=0
